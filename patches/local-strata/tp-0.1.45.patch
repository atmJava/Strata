+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace strata::core {
+
+/// STRATA_TP_GDN: the second half of the GDN QKV/out-proj rows for the *other* stage's layers, resident on
+/// this stage's GPU.  With the local stage's full matrix, native_mmvq_split computes the two halves on the
+/// two GPUs and assembles the full output.  The total dense weight per GPU is unchanged: each stage keeps
+/// its own layers in full and the other stage's QKV/out-proj second half (about 150 MB for this model).
+class TpDense {
+public:
+    TpDense() = default;
+    ~TpDense();
+    TpDense(const TpDense&) = delete;
+    TpDense& operator=(const TpDense&) = delete;
+    /// Load blk.<l>.attn_qkv.weight and blk.<l>.ssm_out.weight for lb <= l < le, second half only.
+    /// The caller makes the target device current.  Returns false with `err` on an unsupported/missing tensor.
+    bool load(const std::vector<std::string>& shards, int64_t lb, int64_t le, std::string& err);
+    const void* find(const std::string& name) const;
+
+private:
+    int device_ = -1;
+    std::map<std::string, void*> weights_;
+};
+
+}  // namespace strata::core
--- strata-official-main-477ac13c/src/kernels/cuda/native_mmvq_split.cu	1970-01-01 00:00:00.000000000 +0000
+++ strata-0.1.45/src/kernels/cuda/native_mmvq_split.cu	2026-10-17 09:47:16.469986722 +0000
@@ -0,0 +1,48 @@
+// Output-split TP for native_mmvq: two devices each compute half the output rows, then both halves
+// are assembled into the contiguous n_out x ncols layout on device 0.
+
+#include "strata/kernels/native_mmvq.hpp"
+
+#include <cuda_runtime.h>
+
+#include <cstdio>
+#include <cstdlib>
+
+namespace strata::kernels {
+
+bool native_mmvq_split(int ggml_type, const void* w0, const void* w1,
+                       const void* xq0, const void* xq1, float* y, float* y0h, float* y1h,
+                       int n_in, int n_out, int ncols, void* stream0, void* stream1,
+                       void* ready1, int device0, int device1) {
+    if (n_out <= 0 || n_out % 2 != 0 || ncols < 1 || ncols > 8) return false;
+    const int half = n_out / 2;
+    const bool debug = std::getenv("STRATA_TP_DEBUG") != nullptr;
+    if (debug)
+        std::fprintf(stderr, "tp split: type %d n_in %d n_out %d ncols %d dev %d/%d\n", ggml_type, n_in, n_out,
+                     ncols, device0, device1);
+    int previous = 0;
+    if (cudaGetDevice(&previous) != cudaSuccess) return false;
+
+    cudaSetDevice(device0);
+    native_mmvq(ggml_type, w0, xq0, y0h, n_in, half, ncols, stream0);
+    if (debug) std::fprintf(stderr, "tp split: local half launched (%s)\n", cudaGetErrorString(cudaGetLastError()));
+    cudaSetDevice(device1);
+    native_mmvq(ggml_type, w1, xq1, y1h, n_in, half, ncols, stream1);
+    if (debug) std::fprintf(stderr, "tp split: peer half launched (%s)\n", cudaGetErrorString(cudaGetLastError()));
+    cudaEventRecord((cudaEvent_t) ready1, (cudaStream_t) stream1);
+    if (debug) std::fprintf(stderr, "tp split: peer event recorded (%s)\n", cudaGetErrorString(cudaGetLastError()));
+
+    cudaSetDevice(device0);
+    cudaStreamWaitEvent((cudaStream_t) stream0, (cudaEvent_t) ready1, 0);
+    if (debug) std::fprintf(stderr, "tp split: local waits for peer (%s)\n", cudaGetErrorString(cudaGetLastError()));
+    const size_t row_bytes = (size_t) half * sizeof(float);
+    cudaMemcpy2DAsync(y, (size_t) n_out * sizeof(float), y0h, row_bytes, row_bytes, ncols,
+                      cudaMemcpyDefault, (cudaStream_t) stream0);
+    cudaMemcpy2DAsync(y + half, (size_t) n_out * sizeof(float), y1h, row_bytes, row_bytes, ncols,
+                      cudaMemcpyDefault, (cudaStream_t) stream0);
+    if (debug) std::fprintf(stderr, "tp split: gathers queued (%s)\n", cudaGetErrorString(cudaGetLastError()));
+    cudaSetDevice(previous);
+    return true;
+}
+
+}  // namespace strata::kernels
--- strata-official-main-477ac13c/src/kernels/native_gemv_tp_bench.cpp	1970-01-01 00:00:00.000000000 +0000
+++ strata-0.1.45/src/kernels/native_gemv_tp_bench.cpp	2026-10-17 09:47:16.469986722 +0000
@@ -0,0 +1,202 @@
+// Real-weight decision gate for tensor parallelism on a GDN dense GEMV.
+//
+//   build/native_gemv_tp_bench <shard1.gguf> <layer> [rows] [iters]
+//
+// Reads blk.<layer>.attn_qkv.weight from the GGUF, quantizes the same activation, and times:
+//   1. one GPU, all output rows via native_mmvq;
+//   2. two GPUs, half the rows each, then both halves are assembled into the full column layout
+//      on GPU0 (the second half crosses NVLink).
+// The two paths use the engine's own quantized kernel and the model's real weight format, so
+// this is the TP decision gate the synthetic FP16 tool cannot answer.  The gather copies one
+// column at a time (the output layout is column-major for ncols rows).
+
+#include "strata/artifact/gguf_reader.hpp"
+#include "strata/kernels/native_mmvq.hpp"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#define CK(x)                                                                      \
+    do {                                                                           \
+        cudaError_t e_ = (x);                                                      \
+        if (e_ != cudaSuccess) {                                                   \
+            std::fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__,                \
+                         cudaGetErrorString(e_));                                  \
+            std::exit(1);                                                          \
+        }                                                                          \
+    } while (0)
+
+namespace K = strata::kernels;
+
+static void enable_peer(int dev, int peer) {
+    CK(cudaSetDevice(dev));
+    const cudaError_t e = cudaDeviceEnablePeerAccess(peer, 0);
+    if (e != cudaSuccess && e != cudaErrorPeerAccessAlreadyEnabled) {
+        std::fprintf(stderr, "peer access %d->%d: %s\n", dev, peer, cudaGetErrorString(e));
+        std::exit(1);
+    }
+}
+
+static double timed(bool split, bool gather, int iters, int n_in, int n_out, int ncols, int type,
+                    const void* w0, const void* w1, const void* xq0, const void* xq1, float* y0,
+                    float* y0h, float* y1, float* yfull, cudaStream_t s0, cudaStream_t s1) {
+    const int half = n_out / 2;
+    cudaEvent_t ev1;
+    CK(cudaSetDevice(1));
+    CK(cudaEventCreateWithFlags(&ev1, cudaEventDisableTiming));
+    auto one = [&]() {
+        CK(cudaSetDevice(0));
+        if (!split) {
+            K::native_mmvq(type, w0, xq0, y0, n_in, n_out, ncols, s0);
+            return;
+        }
+        if (gather) {
+            K::native_mmvq_split(type, w0, w1, xq0, xq1, yfull, y0h, y1, n_in, n_out, ncols, s0, s1,
+                                 ev1, 0, 1);
+            return;
+        }
+        K::native_mmvq(type, w0, xq0, y0h, n_in, half, ncols, s0);
+        CK(cudaSetDevice(1));
+        K::native_mmvq(type, w1, xq1, y1, n_in, half, ncols, s1);
+        CK(cudaSetDevice(0));
+    };
+    for (int i = 0; i < 10; ++i) one();
+    CK(cudaSetDevice(0));
+    CK(cudaDeviceSynchronize());
+    CK(cudaSetDevice(1));
+    CK(cudaDeviceSynchronize());
+    CK(cudaSetDevice(0));
+    const auto t0 = std::chrono::steady_clock::now();
+    for (int i = 0; i < iters; ++i) one();
+    CK(cudaSetDevice(0));
+    CK(cudaDeviceSynchronize());
+    CK(cudaSetDevice(1));
+    CK(cudaDeviceSynchronize());
+    CK(cudaSetDevice(0));
+    const auto t1 = std::chrono::steady_clock::now();
+    CK(cudaSetDevice(1));
+    CK(cudaEventDestroy(ev1));
+    CK(cudaSetDevice(0));
+    return std::chrono::duration<double, std::milli>(t1 - t0).count() / iters;
+}
+
+int main(int argc, char** argv) {
+    if (argc < 3) {
+        std::fprintf(stderr, "usage: native_gemv_tp_bench <shard1.gguf> <layer> [rows] [iters]\n");
+        return 2;
+    }
+    strata::GgufFile gguf(argv[1]);
+    const int layer = std::atoi(argv[2]);
+    const int ncols = argc > 3 ? std::atoi(argv[3]) : 8;
+    const int iters = argc > 4 ? std::atoi(argv[4]) : 100;
+    const int peer_weights = argc > 5 ? std::atoi(argv[5]) : 0;
+    const std::string name = "blk." + std::to_string(layer) + ".attn_qkv.weight";
+    const strata::TensorInfo* t = nullptr;
+    for (const auto& ti : gguf.tensors())
+        if (ti.name == name) t = &ti;
+    if (t == nullptr) {
+        std::fprintf(stderr, "%s not found\n", name.c_str());
+        return 1;
+    }
+    if (t->shape.size() < 2) {
+        std::fprintf(stderr, "%s: unexpected shape\n", name.c_str());
+        return 1;
+    }
+    const int n_in = (int) t->shape[0], n_out = (int) t->shape[1];
+    if (ncols < 1 || ncols > 8) {
+        std::fprintf(stderr, "rows must be 1..8\n");
+        return 1;
+    }
+    if (!K::native_mmvq_supported((int) t->type)) {
+        std::fprintf(stderr, "%s type %s (%u) has no native_mmvq kernel\n", name.c_str(), t->type_name(), t->type);
+        return 1;
+    }
+    if (n_out % 2 != 0) return 1;
+    const size_t wb = K::native_mmvq_weight_bytes((int) t->type, n_in, n_out);
+    const int half = n_out / 2;
+    const size_t xqb = K::native_q8_1_bytes(n_in, ncols);
+    const size_t xb = (size_t) n_in * ncols * sizeof(float);
+    const size_t yb = (size_t) n_out * ncols * sizeof(float);
+    const size_t yhb = (size_t) half * ncols * sizeof(float);
+
+    std::vector<float> hx((size_t) n_in * ncols);
+    for (size_t i = 0; i < hx.size(); ++i) hx[i] = (float) ((i * 17) % 29 - 14) / 64.0f;
+
+    void *w0 = nullptr, *w1 = nullptr, *xq0 = nullptr, *xq1 = nullptr;
+    float *x0 = nullptr, *x1 = nullptr, *y0 = nullptr, *y0h = nullptr, *y1 = nullptr, *yfull = nullptr;
+    float* yref = nullptr;
+    CK(cudaSetDevice(0));
+    CK(cudaMalloc(&w0, wb));
+    CK(cudaMemcpy(w0, gguf.tensor_data(*t), wb, cudaMemcpyHostToDevice));
+    CK(cudaMalloc(&x0, xb));
+    CK(cudaMalloc(&xq0, xqb));
+    CK(cudaMalloc(&y0, yb));
+    CK(cudaMalloc(&y0h, yhb));
+    CK(cudaMalloc(&yfull, yb));
+    CK(cudaMalloc(&yref, yb));
+    CK(cudaMemcpy(x0, hx.data(), xb, cudaMemcpyHostToDevice));
+    CK(cudaSetDevice(1));
+    if (peer_weights)
+        w1 = (uint8_t*) w0 + wb / 2;      // read GPU0's second half over NVLink (peer access is on)
+    else
+        CK(cudaMalloc(&w1, wb / 2));
+    CK(cudaMalloc(&x1, xb));
+    CK(cudaMalloc(&xq1, xqb));
+    CK(cudaMalloc(&y1, yhb));
+    if (!peer_weights)
+        CK(cudaMemcpy(w1, (const uint8_t*) gguf.tensor_data(*t) + wb / 2, wb / 2, cudaMemcpyHostToDevice));
+    CK(cudaMemcpy(x1, hx.data(), xb, cudaMemcpyHostToDevice));
+    enable_peer(0, 1);
+    enable_peer(1, 0);
+
+    cudaStream_t s0, s1;
+    CK(cudaSetDevice(0));
+    CK(cudaStreamCreate(&s0));
+    K::native_quantize_q8_1(x0, xq0, n_in, ncols, s0);
+    CK(cudaSetDevice(1));
+    CK(cudaStreamCreate(&s1));
+    K::native_quantize_q8_1(x1, xq1, n_in, ncols, s1);
+    CK(cudaDeviceSynchronize());
+    CK(cudaSetDevice(0));
+    CK(cudaStreamSynchronize(s0));
+
+    const double full = timed(false, false, iters, n_in, n_out, ncols, (int) t->type, w0, w1, xq0, xq1,
+                              y0, y0h, y1, yfull, s0, s1);
+    const double split = timed(true, true, iters, n_in, n_out, ncols, (int) t->type, w0, w1, xq0, xq1,
+                               y0, y0h, y1, yfull, s0, s1);
+    const double compute = timed(true, false, iters, n_in, n_out, ncols, (int) t->type, w0, w1, xq0, xq1,
+                                 y0, y0h, y1, yfull, s0, s1);
+    std::printf("layer %d %s rows %d n_in %d n_out %d%s\n", layer, t->type_name(), ncols, n_in, n_out,
+                peer_weights ? " peer-weights" : "");
+    std::printf("  one GPU       %.4f ms\n", full);
+    std::printf("  two + gather  %.4f ms  (%.2fx)\n", split, full / split);
+    std::printf("  two compute   %.4f ms  (%.2fx)\n", compute, full / compute);
+
+    // one full result and one assembled split result: the TP path must not change a row's value
+    K::native_mmvq((int) t->type, w0, xq0, yref, n_in, n_out, ncols, s0);
+    CK(cudaStreamSynchronize(s0));
+    (void) timed(true, true, 1, n_in, n_out, ncols, (int) t->type, w0, w1, xq0, xq1, y0, y0h, y1, yfull,
+                 s0, s1);
+    std::vector<float> href(yb / sizeof(float)), hsplit(yb / sizeof(float));
+    CK(cudaMemcpy(href.data(), yref, yb, cudaMemcpyDeviceToHost));
+    CK(cudaMemcpy(hsplit.data(), yfull, yb, cudaMemcpyDeviceToHost));
+    size_t diff = 0;
+    float maxdiff = 0;
+    for (size_t i = 0; i < href.size(); ++i) {
+        if (href[i] != hsplit[i]) {
+            ++diff;
+            maxdiff = std::max(maxdiff, std::fabs(href[i] - hsplit[i]));
+        }
+    }
+    std::printf("  parity        %s (%zu different, max |diff| %.3g)\n",
+                diff == 0 ? "bitwise equal" : "DIFFERS", diff, (double) maxdiff);
+    return 0;
+}
--- strata-official-main-477ac13c/include/strata/kernels/native_mmvq.hpp	2026-10-18 07:56:10.676428977 +0000
+++ strata-0.1.45/include/strata/kernels/native_mmvq.hpp	2026-10-17 09:47:16.469986722 +0000
@@ -135,6 +135,15 @@
 std::size_t native_mmvq_weight_bytes(int ggml_type, int n_in, int n_out);
 void native_mmvq(int ggml_type, const void* weights, const void* x_q8_1, float* y,
                  int n_in, int n_out, int ncols, void* stream);
+/// Output-split TP: w0/w1 are the first/second halves of the rows (n_out/2 each), xq0/xq1 the same
+/// Q8_1 activation on device 0/1, and y the assembled n_out x ncols output on device 0.  The second
+/// half is gathered after the peer stream's `ready1` event.  Both halves are assembled because the
+/// consumer reads a contiguous n_out row per column.  The caller enables peer access and supplies the
+/// half-sized output buffers y0h/y1h.  CUDA implementation; false for an odd n_out or ncols outside 1..8.
+bool native_mmvq_split(int ggml_type, const void* w0, const void* w1,
+                       const void* xq0, const void* xq1, float* y, float* y0h, float* y1h,
+                       int n_in, int n_out, int ncols, void* stream0, void* stream1,
+                       void* ready1, int device0, int device1);
 /// S26 STRATA_LFUSE: native_mmvq(w1 -> y1) and native_mmvq(w2 -> y2), same type / shape / input, in ONE launch,
 /// bitwise the two calls. Returns false (nothing launched) where that is not the case (Q8_0, 2-8 columns only).
 bool native_mmvq_pair(int ggml_type, const void* w1, const void* w2, const void* x_q8_1, float* y1, float* y2,
