+int main(int argc, char** argv) {
+    if (argc < 3) {
+        std::fprintf(stderr, "usage: native_gemv_tp_bench <shard1.gguf> <layer> [rows] [iters] [peer-weights]\n");
+        return 2;
+    }
+    strata::GgufFile gguf(argv[1]);
+    const int layer = std::atoi(argv[2]);
+    const int ncols = argc > 3 ? std::atoi(argv[3]) : 8;
+    const int iters = argc > 4 ? std::atoi(argv[4]) : 100;
+    const int peer_weights = argc > 5 ? std::atoi(argv[5]) : 0;
+    const std::string name = "blk." + std::to_string(layer) + ".attn_qkv.weight";
+    const strata::TensorInfo* t = nullptr;
+    for (const auto& ti : gguf.tensors())
+        if (ti.name == name) t = &ti;
+    if (t == nullptr) {
+        std::fprintf(stderr, "%s not found\n", name.c_str());
+        return 1;
+    }
+    if (t->shape.size() < 2) {
+        std::fprintf(stderr, "%s: unexpected shape\n", name.c_str());
+        return 1;
+    }
+    const int n_in = (int) t->shape[0], n_out = (int) t->shape[1];
+    if (ncols < 1 || ncols > K::kVerifyMaxT) {
+        std::fprintf(stderr, "rows must be 1..%d\n", K::kVerifyMaxT);
+        return 1;
+    }
+    if (!K::native_mmvq_supported((int) t->type)) {
+        std::fprintf(stderr, "%s type %s (%u) has no native_mmvq kernel\n", name.c_str(), t->type_name(), t->type);
+        return 1;
+    }
+    if (n_out % 2 != 0) {
+        std::fprintf(stderr, "%s has an odd number of output rows: no even split\n", name.c_str());
+        return 1;
+    }
+    int devices = 0;
+    CK(cudaGetDeviceCount(&devices));
+    if (devices < 2) {
+        std::fprintf(stderr, "this bench compares one card with two: it needs two GPUs (found %d)\n", devices);
+        return 1;
+    }
+    const size_t wb = K::native_mmvq_weight_bytes((int) t->type, n_in, n_out);
+    const int half = n_out / 2;
+    const size_t xqb = K::native_q8_1_bytes(n_in, ncols);
+    const size_t xb = (size_t) n_in * ncols * sizeof(float);
+    const size_t yb = (size_t) n_out * ncols * sizeof(float);
+    const size_t yhb = (size_t) half * ncols * sizeof(float);
+
+    std::vector<float> hx((size_t) n_in * ncols);
+    for (size_t i = 0; i < hx.size(); ++i) hx[i] = (float) ((i * 17) % 29 - 14) / 64.0f;
+
+    void *w0 = nullptr, *w1 = nullptr, *xq0 = nullptr, *xq1 = nullptr;
+    float *x0 = nullptr, *x1 = nullptr, *y0 = nullptr, *y0h = nullptr, *y1h = nullptr, *yfull = nullptr;
+    float* yref = nullptr;
+    CK(cudaSetDevice(0));
+    CK(cudaMalloc(&w0, wb));
+    CK(cudaMemcpy(w0, gguf.tensor_data(*t), wb, cudaMemcpyHostToDevice));
+    CK(cudaMalloc(&x0, xb));
+    CK(cudaMalloc(&xq0, xqb));
+    CK(cudaMalloc(&y0, yb));
+    CK(cudaMalloc(&y0h, yhb));
+    CK(cudaMalloc(&yfull, yb));
+    CK(cudaMalloc(&yref, yb));
+    CK(cudaMemcpy(x0, hx.data(), xb, cudaMemcpyHostToDevice));
+    CK(cudaSetDevice(1));
+    if (peer_weights)
+        w1 = (uint8_t*) w0 + wb / 2;   // read GPU0's second half across the link (peer access is asked for)
+    else
+        CK(cudaMalloc(&w1, wb / 2));
+    CK(cudaMalloc(&x1, xb));
+    CK(cudaMalloc(&xq1, xqb));
+    CK(cudaMalloc(&y1h, yhb));
+    uint32_t* counter1 = nullptr;
+    CK(cudaMalloc((void**) &counter1, 64));
+    CK(cudaMemset(counter1, 0, 64));
+    if (!peer_weights)
+        CK(cudaMemcpy(w1, (const uint8_t*) gguf.tensor_data(*t) + wb / 2, wb / 2, cudaMemcpyHostToDevice));
+    CK(cudaMemcpy(x1, hx.data(), xb, cudaMemcpyHostToDevice));
+    uint32_t* counter0 = nullptr;
+    CK(cudaSetDevice(0));
+    CK(cudaMalloc((void**) &counter0, 64));
+    CK(cudaMemset(counter0, 0, 64));
+    if (peer_weights) {   // only the variant that reads the other card's weights needs peer access
+        for (const auto [a, b] : {std::pair<int, int>{0, 1}, {1, 0}}) {
+            CK(cudaSetDevice(a));
+            const cudaError_t e = cudaDeviceEnablePeerAccess(b, 0);
+            if (e != cudaSuccess && e != cudaErrorPeerAccessAlreadyEnabled) {
+                std::fprintf(stderr, "peer access %d->%d: %s\n", a, b, cudaGetErrorString(e));
+                return 1;
+            }
+        }
+    }
+
+    // the mapped staging and the two flags, one projection at a time (the engine has one word per projection
+    // of a window; here a round is one projection, so one word each is the same thing)
+    Pair pair;
+    void *h = nullptr, *d = nullptr;
+    mapped(&h, &d, xqb, "activation staging");
+    pair.tp.host_xq = (uint8_t*) d;
+    mapped(&h, &d, yhb, "half-output staging");
+    pair.tp.host_y1 = (float*) d;
+    mapped(&h, &d, 64, "go flag");
+    pair.go_h = (uint32_t*) h;
+    pair.go_d = (uint32_t*) d;
+    mapped(&h, &d, 64, "done flag");
+    pair.done_h = (uint32_t*) h;
+    pair.done_d = (uint32_t*) d;
+    mapped(&h, &d, 64, "wait error words");
+    pair.err_h = (uint32_t*) h;
+    pair.err_d = (uint32_t*) d;
+
+    cudaStream_t s0, s1;
+    CK(cudaSetDevice(0));
+    CK(cudaStreamCreateWithFlags(&s0, cudaStreamNonBlocking));
+    K::native_quantize_q8_1(x0, xq0, n_in, ncols, s0);
+    CK(cudaStreamSynchronize(s0));
+    CK(cudaSetDevice(1));
+    CK(cudaStreamCreateWithFlags(&s1, cudaStreamNonBlocking));
+    K::native_quantize_q8_1(x1, xq1, n_in, ncols, s1);
+    CK(cudaStreamSynchronize(s1));
+    CK(cudaSetDevice(0));
+
+    pair.tp.device0 = 0;
+    pair.tp.device1 = 1;
+    pair.tp.stream0 = s0;
+    pair.tp.stream1 = s1;
+    pair.tp.go = pair.go_d;
+    pair.tp.done = pair.done_d;
+    pair.tp.err = pair.err_d;
+    pair.tp.counter0 = counter0;
+    pair.tp.counter1 = counter1;
+    pair.tp.xq1 = xq1;
+    pair.tp.y1h = y1h;
+    pair.tp.xq_bytes = xqb;
+    pair.tp.y1h_floats = half * ncols;
+    pair.tp.y0h_floats = half * ncols;
+    pair.tp.y_floats = (size_t) n_out * ncols;
+    pair.tp.timeout_ns = 30000ull * 1000000ull;   // the same bound the engine's hand-off waits use
+
+    const double full = timed(0, iters, n_in, n_out, ncols, (int) t->type, w0, w1, xq0, xq1, y0, y0h, y1h,
+                              yfull, s0, s1, pair);
+    const double split = timed(1, iters, n_in, n_out, ncols, (int) t->type, w0, w1, xq0, xq1, y0, y0h, y1h,
+                               yfull, s0, s1, pair);
+    const double compute = timed(2, iters, n_in, n_out, ncols, (int) t->type, w0, w1, xq0, xq1, y0, y0h, y1h,
+                                 yfull, s0, s1, pair);
+    std::printf("layer %d %s rows %d n_in %d n_out %d%s\n", layer, t->type_name(), ncols, n_in, n_out,
+                peer_weights ? " peer-weights" : "");
+    std::printf("  one GPU       %.4f ms\n", full);
+    std::printf("  two + relay   %.4f ms  (%.2fx)\n", split, full / split);
+    std::printf("  two compute   %.4f ms  (%.2fx)\n", compute, full / compute);
+
+    // one full result and one assembled split result: the TP path must not change a row's value
+    CK(cudaSetDevice(0));
+    K::native_mmvq((int) t->type, w0, xq0, yref, n_in, n_out, ncols, s0);
+    CK(cudaStreamSynchronize(s0));
+    (void) timed(1, 1, n_in, n_out, ncols, (int) t->type, w0, w1, xq0, xq1, y0, y0h, y1h, yfull, s0, s1, pair);
+    std::vector<float> href(yb / sizeof(float)), hsplit(yb / sizeof(float));
+    CK(cudaMemcpy(href.data(), yref, yb, cudaMemcpyDeviceToHost));
+    CK(cudaMemcpy(hsplit.data(), yfull, yb, cudaMemcpyDeviceToHost));
+    size_t diff = 0;
+    float maxdiff = 0;
+    for (size_t i = 0; i < href.size(); ++i) {
+        if (href[i] != hsplit[i]) {
+            ++diff;
+            maxdiff = std::max(maxdiff, std::fabs(href[i] - hsplit[i]));
+        }
+    }
+    std::printf("  parity        %s (%zu different, max |diff| %.3g)\n",
+                diff == 0 ? "bitwise equal" : "DIFFERS", diff, (double) maxdiff);
+    return diff == 0 ? 0 : 1;
+}
