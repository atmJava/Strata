+// STRATA_TP_GDN: the peer stage's half of the GDN QKV / out-proj weights, read out of the GGUF shards.
+// A row-major quantized matrix is `n_out` rows of the same byte width (that is how the native GEMV
+// addresses row r), so with an even n_out the second half of the bytes is exactly the second half of the
+// rows - no re-sharding, and the GEMV that runs on the peer card reads its rows the same way it reads the
+// local card's.
+
+#include "strata/core/tp_dense.hpp"
+
+#include "strata/artifact/gguf_reader.hpp"
+#include "strata/kernels/native_mmvq.hpp"
+#include "strata/kernels/verify_kernels.hpp"
+
+#include <cuda_runtime.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+
+namespace strata::core {
+
+TpDense::~TpDense() {
+    // the halves live on the device `load` ran on, so they are freed with that card current - and the card the
+    // caller had current comes back when we are done, because a stage frees these between its own frees.
+    int previous = 0;
+    const bool restored = cudaGetDevice(&previous) == cudaSuccess;
+    if (device_ >= 0) cudaSetDevice(device_);
+    for (auto& kv : weights_) cudaFree(kv.second);
+    if (restored) cudaSetDevice(previous);
+}
+
+const void* TpDense::find(const std::string& name) const {
+    const auto it = weights_.find(name);
+    return it == weights_.end() ? nullptr : it->second;
+}
+
+bool TpDense::load(const std::vector<std::string>& shards, int64_t lb, int64_t le, std::string& err) {
+    if (cudaGetDevice(&device_) != cudaSuccess) {
+        err = "TP dense: no CUDA device";
+        return false;
+    }
+    for (const auto& shard : shards) {
+        try {
+            strata::GgufFile gguf(shard);
+            for (const auto& tensor : gguf.tensors()) {
+                if (tensor.name.rfind("blk.", 0) != 0 || tensor.shape.size() != 2) continue;
+                const size_t dot = tensor.name.find('.');
+                const size_t next = tensor.name.find('.', dot + 1);
+                if (dot == std::string::npos || next == std::string::npos) continue;
+                const int64_t layer = std::strtoll(tensor.name.c_str() + dot + 1, nullptr, 10);
+                if (layer < lb || layer >= le) continue;
+                if (!tensor.name.ends_with(".attn_qkv.weight") && !tensor.name.ends_with(".ssm_out.weight"))
+                    continue;
+                // shape[0] is the reduction dimension (n_in), shape[1] the output rows (n_out): GGUF order,
+                // the same order the native GEMV takes.  An odd n_out has no even split.
+                const int64_t ne0 = (int64_t) tensor.shape[0], ne1 = (int64_t) tensor.shape[1];
+                if (ne0 > std::numeric_limits<int>::max() || ne1 > std::numeric_limits<int>::max()) {
+                    err = "TP dense: tensor too large " + tensor.name;
+                    return false;
+                }
+                // A matrix the split itself cannot run at every window width gets no half: the stage keeps its
+                // single-card GEMV for that projection and splits the rest.  This is the kernel's own predicate,
+                // not a looser copy of it, so a loaded half is one the window can actually use.
+                bool splittable = true;
+                for (int ncols = 1; ncols <= strata::kernels::kVerifyMaxT && splittable; ++ncols)
+                    splittable = strata::kernels::native_mmvq_split_supported(
+                        (int) tensor.type, (int) ne0, (int) ne1, ncols);
+                if (!splittable) continue;
+                if (weights_.count(tensor.name) != 0) {   // the same matrix in two shards: one copy is enough
+                    err = "TP dense: " + tensor.name + " in more than one shard";
+                    return false;
+                }
+                const size_t full =
+                    strata::kernels::native_mmvq_weight_bytes((int) tensor.type, (int) ne0, (int) ne1);
+                const size_t half = full / 2;
+                void* p = nullptr;
+                if (cudaMalloc(&p, half) != cudaSuccess) {
+                    cudaGetLastError();
+                    err = "TP dense: no room for " + tensor.name;
+                    return false;
+                }
+                if (cudaMemcpy(p, (const uint8_t*) gguf.tensor_data(tensor) + half, half,
+                               cudaMemcpyHostToDevice) != cudaSuccess) {
+                    cudaGetLastError();
+                    cudaFree(p);
+                    err = "TP dense: upload " + tensor.name;
+                    return false;
+                }
+                weights_[tensor.name] = p;
+                bytes_ += half;
+            }
+        } catch (const std::exception& e) {
+            err = "TP dense: " + std::string(e.what());
+            return false;
+        }
+    }
+    return true;
+}
