+void Verifier::TpPeer::reset() {
+    int previous = 0;
+    const bool restore = cudaGetDevice(&previous) == cudaSuccess;
+    if (device >= 0) cudaSetDevice(device);
+    if (stream != nullptr) {
+        (void) cudaStreamSynchronize(stream);
+        (void) cudaStreamDestroy(stream);
+        stream = nullptr;
+    }
+    for (void* p : {(void*) xq_stage, (void*) y1_stage, (void*) go_h, (void*) done_h, (void*) err_h})
+        if (p != nullptr) (void) cudaFreeHost(p);
+    if (xq1_d != nullptr) (void) cudaFree(xq1_d);
+    if (y1h_d != nullptr) (void) cudaFree(y1h_d);
+    if (counter_d != nullptr) (void) cudaFree(counter_d);
+    xq_stage = nullptr;
+    y1_stage = nullptr;
+    go_h = go_d = nullptr;
+    done_h = done_d = nullptr;
+    err_h = err_d = nullptr;
+    xq1_d = nullptr;
+    y1h_d = nullptr;
+    counter_d = nullptr;
+    slots = xq_bytes = y1_floats = 0;
+    device = -1;
+    (void) cudaGetLastError();
+    if (restore) cudaSetDevice(previous);
+}
