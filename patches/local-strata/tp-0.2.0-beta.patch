+// Output-split TP for native_mmvq: two cards each compute half the output rows, and the two halves are
+// assembled into the contiguous n_out-per-column layout on the card that runs the window.
+//
+// The payload moves through mapped pinned host memory and both cards' waits are bounded spins on mapped
+// flags - `handoff_publish` / `wait_handoff` / `copy_from_mapped_multi` / `copy_rows_between`, the same
+// hand-off the layer split uses for its residual (docs/MULTI_GPU.md: the split needs no NVLink and no P2P).
+// A cross-device event would need P2P and, inside a window whose stream the host doorbells serve, it is
+// what stalled the first prototype (docs/PERF_GOAL_20261017.md: CUDA0 at 100%, CUDA1 at 0%, the peer
+// kernel never ran): the window's own stream was waiting on an event that only the peer could raise, and
+// the host could not get to the peer's launch until that stream finished.
+
+#include "strata/kernels/native_mmvq.hpp"
+
+#include "strata/kernels/elementwise.hpp"
+#include "strata/kernels/verify_kernels.hpp"
+
+#include <cuda_runtime.h>
+
+#include <cstdint>
+
+namespace strata::kernels {
+namespace {
+
+/// A kernel launch runs on the current device's context, so the peer card's launches have to switch to its
+/// device and back.  The restore runs on every exit path, including a guard that returns part-way.
+struct OnDevices {
+    int previous = 0;
+    bool ok = cudaGetDevice(&previous) == cudaSuccess;
+    ~OnDevices() {
+        if (ok) cudaSetDevice(previous);
+    }
+};
+
+}  // namespace
+
+bool native_mmvq_split_supported(int ggml_type, int n_in, int n_out, int ncols) noexcept {
+    if (n_in <= 0 || n_out <= 0 || n_out % 2 != 0) return false;
+    if (ncols < 1 || ncols > kVerifyMaxT || !native_mmvq_supported(ggml_type)) return false;
+    const bool block32 = ggml_type == 2 || ggml_type == 6 || ggml_type == 8 || ggml_type == 20;
+    const int block = ggml_type == 42 ? 64 : block32 ? 32 : 256;
+    if (n_in % block != 0) return false;
+    const int half = n_out / 2;
+    if ((half & 3) != 0) return false;   // every half-row copy moves float4s
+    const std::size_t xq_bytes =
+        (std::size_t) ncols * (std::size_t) (n_in / 32) * 36;   // one Q8_1 block per 32 values, 36 bytes
+    return xq_bytes != 0 && (xq_bytes & 63) == 0;               // both publishes move float4 words
+}
+
+NativeMmvqTpResult native_mmvq_split(const NativeMmvqTp& tp, int ggml_type, const void* w0, const void* w1,
+                                     const void* xq0, float* y, float* y0h, int n_in, int n_out, int ncols) {
+    // Every guard runs before anything is enqueued, so a decline leaves the caller's streams untouched.
+    if (tp.device0 < 0 || tp.device1 < 0 || tp.device0 == tp.device1) return kNativeMmvqTpDeclined;
+    if (tp.stream0 == nullptr || tp.stream1 == nullptr || tp.host_xq == nullptr || tp.host_y1 == nullptr ||
+        tp.go == nullptr || tp.done == nullptr || tp.err == nullptr || tp.counter0 == nullptr ||
+        tp.counter1 == nullptr || tp.xq1 == nullptr || tp.y1h == nullptr)
+        return kNativeMmvqTpDeclined;
+    if (w0 == nullptr || w1 == nullptr || xq0 == nullptr || y == nullptr || y0h == nullptr)
+        return kNativeMmvqTpDeclined;
+    if (!native_mmvq_split_supported(ggml_type, n_in, n_out, ncols)) return kNativeMmvqTpDeclined;
+    const int half = n_out / 2;
+    const std::size_t xq_bytes = native_q8_1_bytes(n_in, ncols);
+    const std::size_t xq_words = xq_bytes / 4;                               // MappedCopy counts 4-byte words
+    const std::size_t half_floats = (std::size_t) half * ncols;
+    const std::size_t out_floats = (std::size_t) n_out * ncols;
+    if (tp.xq_bytes < xq_bytes || tp.y1h_floats < half_floats || tp.y0h_floats < half_floats ||
+        tp.y_floats < out_floats)
+        return kNativeMmvqTpDeclined;
+    // The mapped buffers and the device buffers the copies touch all need 16-byte alignment.  cudaMalloc and
+    // cudaHostAlloc both give it, so this only catches a caller that passed a pointer into the middle of one.
+    for (const void* p : {(const void*) tp.host_xq, (const void*) tp.host_y1, (const void*) tp.go,
+                          (const void*) tp.done, (const void*) tp.err, (const void*) tp.counter0,
+                          (const void*) tp.counter1, (const void*) tp.xq1, (const void*) tp.y1h, (const void*) y,
+                          (const void*) y0h, xq0, w0, w1})
+        if (((uintptr_t) p & 15) != 0) return kNativeMmvqTpDeclined;
+
+    const OnDevices devices;
+    if (!devices.ok) return kNativeMmvqTpDeclined;
+
+    // device0: put this projection's activation into mapped memory and raise `go` behind it (the publish
+    // kernel fences before it raises, so a card that sees `go` also sees the bytes), then take the first
+    // half of the rows and set it beside where the peer's half will land.  None of this waits for device1.
+    if (cudaSetDevice(tp.device0) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return kNativeMmvqTpDeclined;
+    }
+    handoff_publish((float*) tp.host_xq, (const float*) xq0, (int64_t) xq_words, nullptr, 0, nullptr, 0, tp.counter0,
+                    tp.go, tp.stream0);
+    native_mmvq(ggml_type, w0, xq0, y0h, n_in, half, ncols, tp.stream0);
+    copy_rows_between(y, n_out, y0h, half, ncols, half, tp.stream0);
+
+    // device1: wait for the activation, read it from its own VRAM, compute the second half of the rows, and
+    // publish the half into mapped memory with `done` behind it.  Its waits are on mapped words, never on a
+    // device0 event, so the two cards' graphs cannot wait on each other in a circle.
+    if (cudaSetDevice(tp.device1) != cudaSuccess) return kNativeMmvqTpFailed;
+    wait_handoff(tp.go, 1u, tp.err + 1, tp.timeout_ns, tp.stream1);
+    MappedCopy xq_copy;
+    xq_copy.dst = tp.xq1;
+    xq_copy.src = tp.host_xq;
+    xq_copy.words = (int64_t) xq_words;
+    copy_from_mapped_multi(&xq_copy, 1, tp.stream1);
+    native_mmvq(ggml_type, w1, tp.xq1, tp.y1h, n_in, half, ncols, tp.stream1);
+    handoff_publish(tp.host_y1, tp.y1h, (int64_t) half * ncols, nullptr, 0, nullptr, 0, tp.counter1, tp.done,
+                    tp.stream1);
+
+    // device0: wait for the peer's half and gather it beside its own.  The wait is bounded, so a peer card
+    // that never raised `done` leaves err[0] set and the window fails instead of spinning on the card.
+    if (cudaSetDevice(tp.device0) != cudaSuccess) return kNativeMmvqTpFailed;
+    wait_handoff(tp.done, 1u, tp.err, tp.timeout_ns, tp.stream0);
+    MappedCopy gather[kVerifyMaxT];
+    for (int c = 0; c < ncols; ++c) {
+        gather[c].dst = y + (std::size_t) c * n_out + half;
+        gather[c].src = tp.host_y1 + (std::size_t) c * half;
+        gather[c].words = half;
+    }
+    copy_from_mapped_multi(gather, ncols, tp.stream0);
+    return cudaGetLastError() == cudaSuccess ? kNativeMmvqTpSplit : kNativeMmvqTpFailed;
+}
+
+}  // namespace strata::kernels
--- strata-0.2.0-beta/src/kernels/native_gemv_tp_bench.cpp	1970-01-01 00:00:00.000000000 +0000
+++ strata-0.2.0-tp-20261020/src/kernels/native_gemv_tp_bench.cpp	2026-10-18 06:38:41.000000000 +0000
@@ -0,0 +1,305 @@
+// Real-weight decision gate for tensor parallelism on a GDN dense GEMV.
+//
+//   build/native_gemv_tp_bench <shard1.gguf> <layer> [rows] [iters] [peer-weights]
+//
+// Reads blk.<layer>.attn_qkv.weight from the GGUF, quantizes the same activation on both cards, and times:
+//   1. one GPU, all output rows via native_mmvq;
+//   2. two GPUs, half the rows each, assembled into the full column layout on GPU0 - the engine's path,
+//      kernels::native_mmvq_split, which hands the activation and the half output through mapped pinned host
+//      memory and waits on mapped flags (no peer-to-peer access, no cross-device event);
+//   3. two GPUs, half the rows each, with no relay at all: what the two cards' compute alone costs.
+//
+// Both cards' work is enqueued and then waited for, one projection at a time, because that is how the engine
+// uses it - a window is one graph launch, and its split flags are cleared before the next one.  A back-to-
+// back loop without the reset would let a wait pass on the previous round's flag and measure the two cards
+// drifting apart instead of working on the same projection.
+//
+// The two paths use the engine's own quantized kernel and the model's real weight format, so this is the TP
+// decision gate the synthetic FP16 tool cannot answer.  The last line compares the two results row by row:
+// a split must not change a value.
+//
+// peer-weights=1 (needs peer access, so NVLink or a P2P pair) leaves GPU1 reading GPU0's second half of the
+// weights across the link instead of holding its own copy - the variant docs/PERF_GOAL_20261017.md measured
+// at 0.90x, kept here because it is the option the shipped path rejected.
+
+#include "strata/artifact/gguf_reader.hpp"
+#include "strata/kernels/native_mmvq.hpp"
+#include "strata/kernels/verify_kernels.hpp"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#define CK(x)                                                                      \
+    do {                                                                           \
+        cudaError_t e_ = (x);                                                      \
+        if (e_ != cudaSuccess) {                                                   \
+            std::fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__,                \
+                         cudaGetErrorString(e_));                                  \
+            std::exit(1);                                                          \
+        }                                                                          \
+    } while (0)
+
+namespace K = strata::kernels;
+
+namespace {
+
+/// One projection's worth of buffers on both cards, plus the mapped words the split hands over.
+struct Pair {
+    K::NativeMmvqTp tp;
+    uint32_t *go_h = nullptr, *go_d = nullptr;
+    uint32_t *done_h = nullptr, *done_d = nullptr;
+    uint32_t *err_h = nullptr, *err_d = nullptr;
+};
+
+/// The mapped staging and flags of one projection.  Portable + mapped, as the layer split's hand-off is: both
+/// cards' contexts map the same words, and the device alias has to be the host address because the same
+/// bytes are read and written from two cards (res_pairs_alloc in src/program/generate.cpp checks it the
+/// same way).  The host alias clears them, the kernels read and raise the device one.
+void mapped(void** host, void** dev, size_t bytes, const char* what) {
+    if (cudaHostAlloc(host, bytes, cudaHostAllocMapped | cudaHostAllocPortable) != cudaSuccess ||
+        cudaHostGetDevicePointer(dev, *host, 0) != cudaSuccess || *dev != *host) {
+        std::fprintf(stderr, "%s: %s\n", what, cudaGetErrorString(cudaGetLastError()));
+        std::exit(1);
+    }
+    std::memset(*host, 0, bytes);
+}
+
+/// The engine's stage_inputs, for one projection: the flags start down, and the store is ordered before the
+/// launch the way a window's is.
+void clear_flags(Pair& p) {
+    *(volatile uint32_t*) p.go_h = 0;
+    *(volatile uint32_t*) p.done_h = 0;
+    *(volatile uint32_t*) p.err_h = 0;
+    *(volatile uint32_t*) (p.err_h + 1) = 0;
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+}
+
+/// ms per projection, one projection in flight at a time on both cards.
+/// mode 0: one card, all rows.  mode 1: the split, with the relay.  mode 2: both halves, no relay.
+double timed(int mode, int iters, int n_in, int n_out, int ncols, int type, const void* w0, const void* w1,
+             const void* xq0, void* xq1, float* y0, float* y0h, float* y1h, float* yfull, cudaStream_t s0,
+             cudaStream_t s1, Pair& pair) {
+    const int half = n_out / 2;
+    auto one = [&]() {
+        if (mode == 0) {
+            CK(cudaSetDevice(0));
+            K::native_mmvq(type, w0, xq0, y0, n_in, n_out, ncols, s0);
+        } else if (mode == 1) {
+            clear_flags(pair);
+            const K::NativeMmvqTpResult r = K::native_mmvq_split(pair.tp, type, w0, w1, xq0, yfull, y0h, n_in,
+                                                                 n_out, ncols);
+            if (r != K::kNativeMmvqTpSplit) {
+                std::fprintf(stderr, "native_mmvq_split: %s\n",
+                             r == K::kNativeMmvqTpFailed ? "a CUDA call failed" : "a guard rejected it");
+                std::exit(1);
+            }
+        } else {
+            CK(cudaSetDevice(0));
+            K::native_mmvq(type, w0, xq0, y0h, n_in, half, ncols, s0);
+            CK(cudaSetDevice(1));
+            K::native_mmvq(type, w1, xq1, y1h, n_in, half, ncols, s1);
+        }
+        CK(cudaSetDevice(0));
+        CK(cudaStreamSynchronize(s0));   // the window is over when both cards' halves are where the consumer
+        CK(cudaSetDevice(1));           // reads them: wait for both, as the engine's sync does for its graph
+        CK(cudaStreamSynchronize(s1));
+        CK(cudaSetDevice(0));
+        // err is read through the host alias, which is what this host can read; mapped() above requires the
+        // device alias to be the same address, so the two are one word here
+        if (mode == 1 && (pair.err_h[0] != 0u || pair.err_h[1] != 0u)) {
+            std::fprintf(stderr, "native_mmvq_split: a card gave up waiting for the other (err %u / %u)\n",
+                         pair.err_h[0], pair.err_h[1]);
+            std::exit(1);
+        }
+    };
+    for (int i = 0; i < 10; ++i) one();
+    CK(cudaSetDevice(0));
+    const auto t0 = std::chrono::steady_clock::now();
+    for (int i = 0; i < iters; ++i) one();
+    CK(cudaSetDevice(0));
+    const auto t1 = std::chrono::steady_clock::now();
+    return std::chrono::duration<double, std::milli>(t1 - t0).count() / iters;
+}
