+/// One projection's worth of output-split TP buffers, filled by the caller and reused for every
+/// projection of every window (the flags are cleared per window, see `native_mmvq_split`).  Nothing here
+/// is allocated or freed by the kernels layer.
+struct NativeMmvqTp {
+    int device0 = -1;                    ///< the card the window runs on: it keeps the first half of the rows
+    int device1 = -1;                    ///< the card that takes the second half (a different card)
+    void* stream0 = nullptr;             ///< device0's window stream (the caller's; never destroyed here)
+    void* stream1 = nullptr;             ///< device1's TP stream, dedicated to this pair (non-blocking)
+    uint8_t* host_xq = nullptr;          ///< mapped pinned: the q8_1 activation, staged for device1
+    float* host_y1 = nullptr;            ///< mapped pinned: device1's half output, staged for device0
+    uint32_t* go = nullptr;              ///< mapped pinned: raised when host_xq holds THIS projection's activation
+    uint32_t* done = nullptr;            ///< mapped pinned: raised when host_y1 holds THIS projection's half
+    uint32_t* err = nullptr;             ///< mapped pinned, 2 words: [0] device0's wait gave up, [1] device1's
+    uint32_t* counter0 = nullptr;        ///< device0 memory: handoff_publish's block counter (0 between calls)
+    uint32_t* counter1 = nullptr;        ///< device1 memory: the same, for device1's publish
+    void* xq1 = nullptr;                 ///< device1 memory: the activation device1 reads (native_q8_1_bytes)
+    float* y1h = nullptr;                ///< device1 memory: its half output (n_out / 2 * ncols floats)
+    std::size_t xq_bytes = 0;            ///< capacities the caller allocated; a short buffer is a decline
+    std::size_t y1h_floats = 0;
+    std::size_t y0h_floats = 0;
+    std::size_t y_floats = 0;
+    unsigned long long timeout_ns = 0;   ///< both waits give up after this (0: no bound)
+};
