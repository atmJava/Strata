+/// The result of one `native_mmvq_split` call, which matters because the two kinds of false differ: a
+/// declined projection never touched the streams, so the caller's single-card GEMV can take it; a call that
+/// failed part-way did, so running the single-card GEMV over the same output would mix the two.
+enum NativeMmvqTpResult : int {
+    kNativeMmvqTpDeclined = 0,   ///< a guard rejected it: nothing enqueued, keep the single-card path
+    kNativeMmvqTpSplit = 1,      ///< both halves enqueued, on the two streams
+    kNativeMmvqTpFailed = -1,    ///< a CUDA call failed after something was enqueued: discard the window
+};
