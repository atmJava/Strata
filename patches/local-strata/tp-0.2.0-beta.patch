+bool Verifier::tp_failed(std::string& err) const {
+    if (!tp_on_ || tp_peer_ == nullptr || tp_peer_->err_h == nullptr) return false;
+    const uint32_t here = *(const volatile uint32_t*) tp_peer_->err_h;
+    const uint32_t there = *(const volatile uint32_t*) (tp_peer_->err_h + 1);
+    if (here == 0 && there == 0) return false;
+    const std::string gave_up = " gave up after " + std::to_string(g_split_wait_ns / 1000000ull) + " ms "
+                                "(STRATA_SPLIT_WAIT_MS) waiting for ";
+    err = "verify: STRATA_TP_GDN:";
+    if (here != 0)
+        err += " CUDA" + std::to_string(device_) + gave_up + "CUDA" + std::to_string(tp_peer_->device) +
+               "'s half of a split projection";
+    if (here != 0 && there != 0) err += ", and";
+    if (there != 0)
+        err += " CUDA" + std::to_string(tp_peer_->device) + gave_up + "CUDA" + std::to_string(device_) +
+               "'s activation for a split projection";
+    err += " (the window was not used)";
+    trace_ev("TP-TIMEOUT", -1, lb_, (int64_t) (g_split_wait_ns / 1000000ull));
+    return true;
+}
+
+void Verifier::tp_give_up() {
+    tp_on_ = false;
+    for (int t = 1; t <= strata::kernels::kVerifyMaxT; ++t) {
+        if (exec_[t]) { cudaGraphExecDestroy(exec_[t]); exec_[t] = nullptr; }
+        if (exec_nr_[t]) { cudaGraphExecDestroy(exec_nr_[t]); exec_nr_[t] = nullptr; }
+    }
+    if (tp_peer_ != nullptr && tp_peer_->device >= 0) {
+        const OnDevice on_peer(tp_peer_->device);   // the peer halves live in the peer card's context
+        for (auto& e : tp_exec_)
+            if (e) cudaGraphExecDestroy(e);
+        for (auto& e : tp_exec_nr_)
+            if (e) cudaGraphExecDestroy(e);
+    }
+    for (auto& e : tp_exec_) e = nullptr;
+    for (auto& e : tp_exec_nr_) e = nullptr;
+    if (tp_peer_ != nullptr) tp_peer_->reset();   // the fallback runs single-card; no staging needs to stay mapped
+}
