+bool Verifier::launch_peer(int T, std::string& err) {
+    // the peer half of the variant this path is about to launch: the same `ar_off_` choice, in the same call
+    cudaGraphExec_t& tpt = ar_off_ ? tp_exec_nr_[T] : tp_exec_[T];
+    if (!tp_on_ || tpt == nullptr) return true;   // TP off, or this window size was never paired
+    const OnDevice on_peer(tp_peer_->device);
+    cudaStreamSynchronize(tp_peer_->stream);   // bounded: every wait in the peer graph is bounded
