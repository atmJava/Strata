+/// STRATA_TP_GDN: the second half of the GDN QKV / out-proj rows for the *other* stage's layers, resident on
+/// this stage's GPU.  With the local stage's full matrix, `kernels::native_mmvq_split` computes the two halves
+/// on the two GPUs and assembles the full output.  Each stage keeps its own layers in full and *adds* the
+/// other stage's QKV / out-proj second half, so a card needs half of `native_mmvq_weight_bytes` per matrix
+/// for the peer's layers on top of its previous dense set.  The engine says the byte total it loaded,
+/// because the number follows the quantization and the layer split rather than being a property of the model.
+///
+/// The halves are read straight out of the GGUF shards, so this holds no second copy of the first half and
+/// the model file needs no re-sharding.  Only the two projections the verify window runs as native GGUF GEMVs
+/// are loaded; every other tensor stays with the stage that owns its layer.
+class TpDense {
+public:
+    TpDense() = default;
+    ~TpDense();
+    TpDense(const TpDense&) = delete;
+    TpDense& operator=(const TpDense&) = delete;
+    /// Load blk.<l>.attn_qkv.weight and blk.<l>.ssm_out.weight for lb <= l < le, second half only, onto the
+    /// caller's current device (the device `find`'s pointers are valid for).  A matrix the native GEMV cannot
+    /// run, or whose output rows are odd (no even split), gets no half and `find` returns null for it: the
+    /// stage then keeps its single-device GEMV for that projection and splits the rest.  `err` is for the
+    /// failures that are not that: an unreadable shard, the same matrix in two shards, no room, no upload.
+    bool load(const std::vector<std::string>& shards, int64_t lb, int64_t le, std::string& err);
+    /// The half's device pointer, or null when this matrix was not loaded (the caller keeps its own path).
+    const void* find(const std::string& name) const;
+    /// What the load put on the device: how many matrices and how many bytes (the start-up line).
+    size_t count() const { return weights_.size(); }
+    size_t bytes() const { return bytes_; }
+
+private:
+    int device_ = -1;
+    size_t bytes_ = 0;
+    std::map<std::string, void*> weights_;
+};
